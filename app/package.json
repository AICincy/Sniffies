{
  "name": "sniffies-workbench",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "doctor": "powershell -ExecutionPolicy Bypass -File ../scripts/android-doctor.ps1",
    "apk:inspect": "powershell -ExecutionPolicy Bypass -File ../scripts/inspect-apk.ps1",
    "verify": "npm run build && npm run test -- --watch=false",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && powershell -ExecutionPolicy Bypass -File ../scripts/android-build.ps1"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.5.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
